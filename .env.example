# Single source of truth for all component wiring (TRD §7). Copy to .env and edit.
# Duration syntax everywhere: <int><s|m|h|d|w>.

# Dashboard hostname (Caddy + cookies) — stage 2+
DOMAIN=dash.example.com
# Public UDP port devices send 22-byte IMU datagrams to (TRD §3)
UDP_PORT=5005
# api service port, internal only (Caddy proxies it from stage 2)
API_PORT=8000

# --- TimescaleDB ---
# DB hostname (compose service name)
POSTGRES_HOST=db
# DB port (internal only, no host publish)
POSTGRES_PORT=5432
# Database name
POSTGRES_DB=mvpdash
# Database user
POSTGRES_USER=mvpdash
# Database password — placeholder, set a real one in .env
POSTGRES_PASSWORD=changeme

# Redis broker (pub/sub + status keys only)
REDIS_URL=redis://redis:6379/0

# --- Auth (REQUIRED: the api refuses to start without JWT_SECRET) ---
# JWT signing secret (HS256) — placeholder, set a real one in .env
JWT_SECRET=changeme-generate-a-long-random-string
# JWT/cookie lifetime in hours
JWT_EXPIRE_HOURS=24
# Comma-separated user:pass pairs, re-seeded by the api entrypoint on every start.
# This is the ONLY way into the dashboard — change it before exposing the box.
SEED_USERS=trainer:changeme

# Expected wearable stream rate per sensor (Hz) — measured live, this is the reference
EXPECTED_INPUT_HZ=640
# Constant output tick rate (Hz): biomech ticks + WS + DB writes
OUTPUT_HZ=60
# (source_id,sensor_id) -> limb, JSON with "src,sen" keys (TRD §3 defaults)
LIMB_MAP={"0,1": "left_shin", "0,2": "left_thigh", "1,1": "right_thigh", "1,2": "right_shin"}
# Reorder window (ms) samples are held for in-order release
JITTER_BUFFER_MS=50
# Seconds without packets before a device counts as offline (ticker suspends)
OFFLINE_AFTER_S=2
# Clock-offset jump (s) treated as a device/leg reboot (source buffers reset)
RESET_OFFSET_JUMP_S=5

# Past rolling windows shown in the UI — 3 durations (deployment e.g. 1h,1d,3d)
PAST_WINDOWS=5m,30m,2h
# Future forecast horizons — deployment e.g. 1d,3d,1w
FUTURE_HORIZONS=10m,30m,1h
# Seconds between prediction runs
PREDICT_INTERVAL_S=60
# History window the prediction model trains on
PREDICT_TRAIN_WINDOW=2h
# --- forecast bootstrap (docs/ANALYTICS.md §2.1) ---
# The steady model needs 10 one-minute metrics_1m buckets, which put the first
# forecast 15-20 min into a session. The bootstrap path fits the SAME model to
# sub-minute buckets off the raw table, reaching 10 buckets in 2.5 min, and
# hands back to the aggregate as soon as it can serve the device.
PREDICT_BOOTSTRAP_BUCKET_S=15
PREDICT_BOOTSTRAP_WINDOW=15m
# Early horizons, each published only while it is <= the data observed so far
PREDICT_BOOTSTRAP_HORIZONS=1m,2m,5m
# --- insight cadence: tune these four as a SET (docs/ANALYTICS.md §4.6) ---
# Short window the rules read as "now", served from the raw 60Hz table. This is
# what makes an action appear within ~30-45s instead of the 5-9 min a 5-minute
# mean needed to cross a threshold. Baseline/spread/trend still come from
# PAST_WINDOWS above.
INSIGHT_LIVE_WINDOW=30s
# Seconds between insight-rule evaluations
INSIGHT_INTERVAL_S=15
# Per-rule cooldown (s) to avoid insight spam
INSIGHT_COOLDOWN_S=120
# How long an action stays on /api/insights/current after its rule last fired.
# MUST be > INSIGHT_COOLDOWN_S or the panel flickers when a condition persists.
INSIGHT_HOLD_S=150
# Hard cap on simultaneous actions shown by /api/insights/current
INSIGHT_MAX_ACTIONS=3
# Composite thresholds for the starter insight rules, on the 0-100 scale
INSIGHT_WARN_THRESHOLD=85
INSIGHT_ALERT_THRESHOLD=92
# 60Hz metrics hypertable retention (aggregates kept forever)
METRICS_RETENTION=30d

# Gap after which biomech drops accumulated load + learned baselines
# (>> OFFLINE_AFTER_S so a brief dropout doesn't wipe a session)
SESSION_GAP_S=300
# Hard cap on tracked devices; extras are dropped and counted
MAX_DEVICES=5
